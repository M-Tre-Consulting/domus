    <!-- Geofencing -->
    <string name="geofence_section_title">Standort-Geofence</string>
    <string name="geofence_section_subtitle">Benachrichtigt Home Assistant, wenn du an einem Ort ankommst oder ihn verlässt, damit anwesenheitsbasierte Automatisierungen (wie \"alles ausschalten, wenn ich gehe\") automatisch funktionieren.</string>
    <string name="geofence_permission_needed">Domus benötigt Standortzugriff, einschließlich \"Immer zulassen\", um Ankünfte und Abfahrten im Hintergrund zu erkennen.</string>
    <string name="geofence_grant_button">Standortzugriff gewähren</string>
