<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      House mark v4: a monogram, not a silhouette - a roofline stroke (house), a lightning bolt
      (smart/power) and an open ring reading as a "D" (Domus) all interlocked, each in its own
      flat accent color, layered over the pastel blob background.
    -->
    <!-- Roofline: open stroke, left wall up to a peak, down to a right wall stub - a
         recognizable house outline (roof + two wall stubs), not just a checkmark. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4E7FE0"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M32,63 L32,46 L45,33 L58,46 L58,59" />
    <!-- "D" ring: open circular arc, gap facing the house/bolt. Same stroke weight as the
         roofline so the two read as one balanced pair rather than the ring dominating. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#55A66B"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M51.39,41.39 A15,15 0 1 1 51.39,62.61" />
    <!-- Bolt: solid fill, drawn last so it binds the composition together on top. -->
    <path
        android:fillColor="#FFC145"
        android:pathData="M43.83,76.62 L47.99,61.07 L39.11,58.69 L60.17,33.38 L56.01,48.93 L64.89,51.31 Z" />
</vector>
